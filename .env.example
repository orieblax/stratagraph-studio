# ==============================================================================
# StrataGraph Studio - Environment Configuration Template
# ==============================================================================

# Application & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SAFE_UPLOAD_DIR=./safe_uploads

# Security & Authentication
JWT_SECRET_KEY=change_me_to_a_secure_random_key_with_at_least_32_characters!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_TOKENS_PER_MINUTE=120

# Local PostgreSQL & pgvector Database
POSTGRES_USER=stratagraph
POSTGRES_PASSWORD=stratagraph_secure_password
POSTGRES_DB=stratagraph_studio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://stratagraph:stratagraph_secure_password@localhost:5432/stratagraph_studio

# Databricks Lakehouse & Model Serving
DATABRICKS_HOST=https://dbc-xxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi_placeholder_token_change_at_runtime
DATABRICKS_SQL_WAREHOUSE_ID=xxxxxx_warehouse_id
DATABRICKS_CATALOG=stratagraph_catalog
DATABRICKS_SCHEMA=agent_analytics
DATABRICKS_VOLUME=raw_ingest_volume
DATABRICKS_VECTOR_SEARCH_INDEX=stratagraph_catalog.agent_analytics.gold_vector_index
DATABRICKS_SERVING_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# Supabase Cloud (Optional Remote Vector & Task Store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...placeholder_service_key
SUPABASE_DB_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# Model Providers & LLM Tiering
OPENAI_API_KEY=sk-placeholder-openai-api-key
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key
OLLAMA_BASE_URL=http://localhost:11434

# Hardware & Quantized Re-Ranker FinOps Policy
# Options: onnx-int8, cpu, cuda
RERANKER_DEVICE_POLICY=onnx-int8
SEMANTIC_CACHE_THRESHOLD=0.92
MAX_ITERATIONS=3
MAX_COST_USD=1.50

# LangSmith Observability & Evals
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_placeholder_key
LANGSMITH_PROJECT=stratagraph-studio
EVAL_SAMPLING_RATE=0.25
