# ==============================================================================
# StrataGraph Studio — Vercel Production Environment Variables
# ==============================================================================
# Set these in your Vercel Project Settings -> Environment Variables

# Public/Client-accessible Backend URL (points to your deployed FastAPI backend)
# Example: https://api.stratagraph.yourdomain.com or https://stratagraph-backend.railway.app
NEXT_PUBLIC_BACKEND_URL=https://api.stratagraph.yourdomain.com

# Server-side Backend URL for Next.js internal proxy route (/api/backend)
BACKEND_URL=https://api.stratagraph.yourdomain.com
